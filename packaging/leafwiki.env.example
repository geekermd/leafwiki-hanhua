# LeafWiki 运行配置（systemd EnvironmentFile）
# 所有选项也可用命令行参数传入，命令行 > 环境变量 > 默认值。
# 改完执行：sudo systemctl restart leafwiki

# ---- 必填：JWT 签名密钥（安装时自动生成，勿泄露；改动会使所有登录态失效）----
LEAFWIKI_JWT_SECRET=请填入随机字符串

# ---- 初始管理员（仅在没有管理员用户时生效）----
LEAFWIKI_ADMIN_USERNAME=admin
LEAFWIKI_ADMIN_PASSWORD=请填入至少 8 位口令

# ---- 监听：只绑回环，公网只能经 cloudflared 隧道进入 ----
LEAFWIKI_HOST=127.0.0.1
LEAFWIKI_PORT=8080

# ---- 数据与日志 ----
LEAFWIKI_DATA_DIR=/var/lib/leafwiki
LEAFWIKI_LOG_LEVEL=info

# ---- 反向代理：信任本机 nginx 传来的 X-Forwarded-* ----
LEAFWIKI_TRUSTED_PROXY_IPS=127.0.0.1

# ---- 快照（含 SQLite 的完整 ZIP 备份）----
LEAFWIKI_SNAPSHOT=true
LEAFWIKI_SNAPSHOT_INTERVAL=24h

# ---- 默认界面语言（本包已内置简体中文 zh）----
LEAFWIKI_DEFAULT_LANGUAGE=zh
